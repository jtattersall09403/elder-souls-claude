        "pressure"
      ],
      "synth": {
        "kind": "noise",
        "colour": "brown",
        "filter": {
          "type": "bandpass",
          "hz": 255,
          "q": 4.2
        },
        "gain_db": -8,
        "width": 0.05,
        "mod": {
          "target": "gain",
          "lfo_hz": 0.023,
          "depth": 0.12
        }
      }
    },
    "L2": {
      "id": "l2_thorn_clatter_only",
