  "finding": {
    "id": "FD1-FD2-coverage",
    "what": "the fidelity check silently drops the screens it cannot see",
    "mechanism": "tools/metrics/ui-metrics.mjs picks its measurement region with `ui.elements.filter(e => e.visible && e.text && e.text.length > 40 && ['book_page','journal_entry','detail_panel','attribute_preview'].includes(e.kind))` - a hard-coded whitelist of four element kinds. game/src/ui/screens/progress.js draws the skills sheet as `sheet_row` and `attribute_row`, neither of which is on the list. The grader then computes `at(dpr) = out.captures.filter(c => c.stem_transition_device_px !== null)` and reports 'PASS ... over N screens', so a screen that returned nothing is removed from the median rather than reported as unmeasured.",
    "screens_returning_zero_samples": [
      "sheet",
      "spells"
    ],
    "reproduced_in_every_completed_configuration": true,
    "also": "the map screen is not in SCREENS at all, so three of the build's seven screens have never had their type fidelity measured."
  },
