  "reproduce": [
    "node tools/runpod/cli.mjs run --max-runtime 45 --artifact-dir reports/runpod-gpu/runs/<tag> --command 'node tools/visual/w1-30b-probe.mjs --tag gpu --hardware --canvas 1280x720 --motion street-lilmoth --out \"$RUNPOD_ARTIFACT_DIR/probe\"'",
    "node tools/runpod/cli.mjs run --max-runtime 25 --artifact-dir reports/runpod-gpu/runs/<tag> --command 'node tools/visual/w1-30b-roughness.mjs --tag gpu --hardware --out \"$RUNPOD_ARTIFACT_DIR/roughness\"'",
    "node tools/visual/w1-30b-air.mjs            # offline, no GPU, prints all thirteen regions",
    "node tools/visual/w1-30b-air.mjs --weather rain --distance 150"
  ],
