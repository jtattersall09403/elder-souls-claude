  "p3": {
    "engine_backdoor_used": true,
    "why": "no harness verb writes a rank row; the tree is not edited",
    "rows": [
      {
        "faction": "the_rootkeepers",
        "rank1_before": {
          "reputation": 10,
          "attribute": 8,
          "skill_1": 20
        },
        "said_at_default": "The slate has 0 beside your name and a Leaf has 10. That is not a rule I made and I cannot rub it out. Go and do some counting.",
        "need_at_default": 10,
        "said_with_rep_moved_to_37": "The slate has 0 beside your name and a Leaf has 37. That is not a rule I made and I cannot rub it out. Go and do some counting.",
        "need_after": 37,
        "sentence_moved": true,
        "number_is_the_perturbed_one": true,
        "said_when_reputation_is_met": "You're on the slate. That's the whole ceremony, and it's the only thing the Rootkeepers own.",
        "kind_when_reputation_is_met": "welcome",
        "kind_changed": true
      },
      {
        "faction": "the_drowned_court",
        "rank1_before": {
          "reputation": 10,
          "attribute": 9,
          "skill_1": 20
        },
        "said_at_default": "The tally has you at 0. Knee-Deep is 10. You'll get there or you won't, and either way the bay keeps sending them.",
        "need_at_default": 10,
        "said_with_rep_moved_to_37": "The tally has you at 0. Knee-Deep is 37. You'll get there or you won't, and either way the bay keeps sending them.",
        "need_after": 37,
        "sentence_moved": true,
        "number_is_the_perturbed_one": true,
        "said_when_reputation_is_met": "You're in the tally. Everyone gets in it eventually. You've just done it standing up.",
        "kind_when_reputation_is_met": "welcome",
        "kind_changed": true
      },
      {
        "faction": "the_dockhands",
        "rank1_before": {
          "reputation": 10,
          "attribute": 8,
          "skill_1": 20
        },
        "said_at_default": "The board doesn't know you. 0 against 10, and the hands put the names up, not me.",
        "need_at_default": 10,
        "said_with_rep_moved_to_37": "The board doesn't know you. 0 against 37, and the hands put the names up, not me.",
        "need_after": 37,
        "sentence_moved": true,
        "number_is_the_perturbed_one": true,
        "said_when_reputation_is_met": "Your name's on the board. It stays there until the rain gets in or the hands rub it off.",
        "kind_when_reputation_is_met": "welcome",
        "kind_changed": true
      }
