#!/bin/sh
# Blocking pre-commit gate — corpus/80-methods/RI-MTH05 M8.
#
# Install with:  npm run hooks:install      (git config core.hooksPath .githooks)
#
# It runs only when the commit touches something the gate is about, so ordinary
# game/ and docs/ commits are not slowed down. RI-MTH05 hard fail 4 forbids making
# this advisory: do not add `|| true`, and do not tell people to use --no-verify.
set -e

# A commit that leaves game/data/index.json pointing at a file that is not there stops the
# game booting, and nothing else in the toolchain notices until a critic wastes a round on
# it. Blocking, and deliberately so.
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^game/data/'; then
  node tools/check-data.mjs
fi

# Hand-authored quest routes must not vanish when a generator re-runs. Nine were lost
# once already, in a commit whose diffstat read "5 insertions, 179 deletions" on a file
# nobody meant to touch.
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^game/data/quests/'; then
  node tools/check-content.mjs
fi

# Hooks and entry topics must name quests and journal entries that exist. This used to throw
# from the QuestEngine constructor, which meant a hook written minutes before its quest did not
# fail its author — it failed EVERY agent on the box, because they all boot-check before they
# measure. That happened four times in one day. Same check, over the JSON, with no browser, at
# the point where it costs one person instead of thirteen. Non-blocking for the same reason as
# the boot check below: banking in-flight work is worth more than a clean tree.
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^game/data/quests/'; then
  node tools/check-quests.mjs || echo "pre-commit: quest integrity problems above — fix before this ships."
fi

# Prose voice. W1-PROSE-TICS removed 768 `-body` forms from the corpus and other agents' work put
# 216 back within hours, because nothing ran afterwards. The round-1 blind judge said the same from
# the other side: a prose constraint fixed once and not enforced by a check that RUNS decays within
# hours on a busy tree. So it runs here, on the commits that can cause the decay.
#
# WARNING, NOT BLOCKING — the precedent and the reasoning are check-quests' attribute-scale audit
# above. Dialogue, book and journal text belong to a dozen pieces at once; a fail-closed assertion
# here would turn a shared hook red for every agent on the box over prose none of them owns. It
# costs ~1.2s, reads only JSON, and needs no browser and no reference corpus.
# `node tools/check-prose.mjs --verbose` for every file, `--file <path>` for one,
# `--strict` for a non-zero exit if your piece wants to hold its own line.
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^game/data/(dialogue|books|quests)/'; then
  node tools/check-prose.mjs || echo "pre-commit: prose-voice check could not run — see above."
fi

# Buildings inside other buildings. The class was never counted until W1-BUILDING-OVERLAP-CENSUS
# did: 83 pairs interpenetrate by more than a wall, an eave and a porch, across 8 of 8 settlements,
# and 63 of them are INVISIBLE to the shipped resolver because `planSettlement()`'s shrink pass and
# `province.js#_deepOverlaps()` both compare axis-aligned footprints while `settlementSolids()`
# rotates them by `yaw_deg`. The first two buildings a player meets were 7.02 x 4.00 m inside each
# other, with a front door opening into the neighbour.
#
# A RATCHET, not an assertion (RULES.md rule 13 — the debt exists, so a fail-closed "zero" gate
# would throw for every agent on the box). It fails only when the world gets WORSE: a settlement's
# count goes up, a pair overlaps that did not, or a door ends up inside another building. ~2s, JSON
# only, no browser. `node tools/check-building-overlap.mjs --self-break` proves it fires.
#
# WARNING, NOT BLOCKING, for check-quests' stated reason: town geometry belongs to several pieces
# at once and banking in-flight work is worth more than a clean tree. REVERSIBLE: promote this to
# blocking once the remaining 82 have been resolved by their own piece and the floor is low enough
# that a red here is always a real regression rather than someone else's work in progress.
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^game/(data/world/(settlements|interiors)/|src/render/exterior\.js)'; then
  node tools/check-building-overlap.mjs || echo "pre-commit: a building moved into another building — see above. Not blocking; fix it or re-freeze deliberately."
fi

# Does the game actually come up? smoke.mjs is an environment self-test and says so in
# its own header — it never touches the engine, so a build whose engine throws during
# setup passed every boot check on this tree while three agents lost measurement rounds
# to it. Only run on commits that touch game/, since it costs ~20s.
#
# Deliberately NOT blocking. Committing in-flight work is what survives a container reclaim —
# it has already saved seven agents' output once — and in-flight work frequently does not boot.
# Blocking here would trade a real guarantee for a cosmetic one. The orchestration tick treats
# a red boot as actionable and fixes or reverts the offending hunk; this is the alarm, not the gate.
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^game/'; then
  node tools/harness/boot-check.mjs || {
    echo ""
    echo "pre-commit: ##############################################################"
    echo "pre-commit: THE ENGINE DOES NOT CONSTRUCT. Committing anyway to bank work."
    echo "pre-commit: Every measurement taken against this build is void until fixed."
    echo "pre-commit: ##############################################################"
    echo ""
  }
fi

# Regenerate the orientation index (orchestration/INDEX.md — not the corpus one below). It is
# derived from the tree, so it cannot drift, which is the whole reason a dozen concurrent agents
# can trust it instead of each paying to rediscover the same 441 tools. Must run BEFORE the early
# exit further down, or it would only ever refresh on corpus commits.
node tools/gen-index.mjs >/dev/null 2>&1 || echo "pre-commit: gen-index failed — orchestration/INDEX.md may be stale."
# gen-index writes FOUR files: the index itself, plus the full tool/item/harness listings that used
# to be inline in it. They moved out because every agent reads INDEX.md on cold start and was paying
# 51k tokens for listings it mostly did not need (DOC-POLICY: "an index points; it does not
# contain"). All four are staged for the same reason INDEX.md always was — the hook regenerates them,
# so a commit that leaves them unstaged leaves the tree permanently dirty. Expected, not a sweep.
git add orchestration/INDEX.md orchestration/index/TOOLS.md orchestration/index/ITEMS.md orchestration/index/HARNESS.md 2>/dev/null || true

# Keep the published page current on EVERY commit. GitHub Pages serves /docs from this
# branch, so a stale page is a silent lie about where the project is — and gating this on
# which paths changed is how it went stale in the first place. Both generators are cheap.
# publish.mjs also refreshes the cost ledger (tools/cost-refresh.mjs -> docs/data/cost-ledger.json)
# so the published cost figure is never more than one bank old — COST.md §6, "refresh cadence:
# every bank". Both the ledger and its failure marker are staged: an unstaged failure marker means
# the page on the site claims a reading is current when the local tree knows it is not.
node tools/publish.mjs >/dev/null 2>&1 || true
git add docs/index.html docs/progress.html docs/status.json 2>/dev/null || true
# -A is scoped to docs/data/ deliberately (rule 17 forbids an unscoped one): the failure marker is
# DELETED on a successful refresh, and `git add <path>` cannot stage a deletion, so a cleared
# failure would otherwise stay committed and the page would keep crying wolf.
git add -A docs/data 2>/dev/null || true

# Keep the PLAYABLE copy current. GitHub Pages serves docs/, and the game lives in game/, so until
# this existed the game was not on the web at all and the answer to "how do I play this on a phone"
# was "you can't". docs/play/ is generated from game/ and is never a source; --check fails loudly if
# somebody edits it, which is the reader that stops this becoming the fifth mirror in this project.
# Only regenerate when game/ actually changed — it is 710 files and every commit does not need it.
# Everything the game imports must be IN the repository, not merely on this disk.
# `game/src/input/hold-gate.js` was written, imported by two modules, and never committed: it ran
# perfectly here and 404'd on the deployed site, where a failed ES module import draws nothing and
# reports nothing. The owner got a black screen on their phone and no instrument could have seen
# why, because every check ran against a machine where the file existed. THAT PROTECTION STAYS.
#
# GATE-BLAST-RADIUS (rule 13, second offence): this WAS unconditionally blocking, over every
# tracked-or-staged file in the whole tree, not just this commit's own paths. A builder hit
# fourteen consecutive refusals over two files belonging to a different, concurrently running
# agent — untracked on disk, imported by a file tracked in some earlier, unrelated commit. Narrowing
# the SCAN (tracked-or-staged only) had already happened and did not touch this, because the
# importer in that shape is itself tracked; the fix has to be about which PROBLEMS block, not which
# files are scanned. So: `check-shipped-files.mjs` now blocks only a problem THIS commit can fix —
# the offending importer or target is among the paths this very commit is writing (verified: `git
# commit --only <paths>` runs this hook against a temporary index containing exactly those paths,
# so the check sees precisely what is about to be committed). Everything else prints loudly, names
# the importer and (via `tools/ownership.mjs --for`) whoever owns it if known, and lets the commit
# through. The single blocking gate over EVERYTHING, self-introduced or not, is `tools/bank.mjs`
# (`--strict`) at push/deploy time — one actor who can actually act on it, not a dozen racing agents
# each hitting a wall over work that is not theirs.
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^game/'; then
  node tools/check-shipped-files.mjs
fi

git diff --cached --name-only --diff-filter=ACMR \
  | grep -Eq '^(corpus/.*RI-.*\.md|corpus/00-doctrine/(subsystems|constants)\.json|tools/corpus-index\.mjs)$' \
  || exit 0

echo "pre-commit: corpus coherence gate (node tools/corpus-index.mjs --check)"

# A stale INDEX.md is the most common way this gate trips, and INDEX.md is a generated
# file, so fixing it by hand is never the right move. Regenerate and stage it, then
# re-run the gate for real. The `Generated:` timestamp is ignored by --check, so this
# only fires when the index is genuinely out of date.
if ! node tools/corpus-index.mjs --check >/dev/null 2>&1; then
  node tools/corpus-index.mjs >/dev/null
  if ! git diff --quiet -- corpus/00-doctrine/INDEX.md; then
    git add corpus/00-doctrine/INDEX.md
    echo "pre-commit: INDEX.md was stale; regenerated and staged."
  fi
fi

node tools/corpus-index.mjs --check

# Whose work is in this commit? Twice in one session an agent finished, ran `git add -A`, and swept
# a neighbour's in-flight work into its own commit — once burying a critic's staged verdict, tools,
# screenshot and blog line under a builder's message. Rule 17 warned about it in prose and prose
# lost twice in a day, so the list is printed here, where it can still be acted on.
#
# WARNING, NOT BLOCKING. The committer is often the legitimate claimant, the orchestrator banks the
# whole tree on purpose (rule 28), and a hard block with a dozen agents committing concurrently
# would deadlock the fleet to prevent a recoverable attribution error. What was missing was never
# permission — it was seeing the list in time. Note that unstaging is not the whole answer:
# `git commit` takes the entire index, so the reliable form is `git commit --only <your paths>`.
node tools/ownership.mjs --staged "${ES_TASK_ID:-}" || true

# ---------------------------------------------------------------------------------------------
# Citation staleness — do the documents that direct work still describe the repo correctly?
#
# The project owner named this on 2026-08-14 as the most expensive pattern in the project, after
# four instances in one day: twenty-nine plans against a superseded bar; six UI items guessing at
# HUD geometry that was vendored on disk; a corpus that told builders 33 screenshots were not there
# while they had been on disk since 6 August; and an n=0 that was a property of a wrongly-scoped
# anchor rather than of the world. See `tools/check-citations.mjs` for the full account.
#
# WARNING, NOT BLOCKING, on the same reasoning as the prose and ownership gates above: the findings
# are usually in documents the committer does not own, and a hard block would stop the wrong person.
# What was missing was never permission — it was seeing it. `--self-test` proves the checks fire.
echo "pre-commit: citation-staleness gate (node tools/check-citations.mjs)"
node tools/check-citations.mjs || echo "pre-commit: citation staleness above — a document is describing a repo that no longer exists. Not blocking; fix or hand over."

# STATUS.md is the owner's window and had no guard until 2026-08-15, when the orchestrator
# character-spliced it (a slice assignment given a string, not a list) — 176 lines became 1,635
# lines of single letters and nothing noticed. Warning only: a status page is written by hand and
# a blocking gate on prose would be the over-engineering the owner already rejected once.
echo "pre-commit: STATUS.md sanity (node tools/check-status-sane.mjs)"
node tools/check-status-sane.mjs || echo "pre-commit: STATUS.md above is not shaped like a status page. Not blocking; look at it."
