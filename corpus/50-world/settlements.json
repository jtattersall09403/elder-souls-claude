    "Soulrest": {
      "x": 610.5,
      "z": 4877.0,
      "source_px": [
        618,
        1382
      ],
      "tier": "village",
      "region": "Stone Wastes",
      "identity": "A dying village around a dying Hist. It was a port; the bay silted; now it mines salt and old bones out of the Wastes. Industry: salt, bone, scavenging. Tension: the villagers are openly debating whether to burn their Hist before it dies on its own, which is the single most blasphemous conversation in Argonia and they are having it in the street. Layout tells you: every house faces the tree and the tree is grey.",
      "nearest_neighbour": "Blackrose",
