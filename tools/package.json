{
  "name": "elder-souls-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Measurement harness for the Elder Souls corpus. See corpus/80-methods/HARNESS.md.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "node harness/smoke.mjs",
    "all": "node run-all.mjs",
    "index": "node corpus-index.mjs",
    "index:check": "node corpus-index.mjs --check",
    "ledger": "node gap-ledger.mjs",
    "verdicts": "node verdict-validate.mjs --all",
    "doctrine": "node corpus-index.mjs && node gap-ledger.mjs && node verdict-validate.mjs --all"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "jpeg-js": "^0.4.4",
    "pixelmatch": "^6.0.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0"
  }
}
