{
  "schema": "elder-souls/prose-tic-rules@1",
  "registered_by": "W1-PROSE-TICS builder",
  "registered_at": "before any measurement was taken on any corpus",
  "how_to_read_this": [
    "These 46 rules were written down from prior belief about how machine-written English differs",
    "from human game writing. NONE of them was chosen after looking at a result. The only rule that",
    "was known in advance to fire is `eleven` (RULE-01): the W1-LIBRARY round-1 critic had already",
    "measured it, and it is included as a positive control rather than as a discovery.",
    "The multiple-comparisons count for this run is therefore 46, and every one of the 46 is",
    "reported in the results table with its rate on both sides, not only the winners.",
    "A rule that separates at p<0.05/46 (Bonferroni) is called SIGNIFICANT; anything else is",
    "reported as measured and explicitly not claimed."
  ],
  "statistic": {
    "rate": "matches per 10,000 words, computed separately for each register",
    "presence": "share of documents containing >= 1 match",
    "separation": "accuracy of the classifier 'presence >= 1 => ours' over ours+reference documents, against the majority-class baseline",
    "registers_are_never_mixed": "books<->books, dialogue<->dialogue, journal<->journal"
  },
  "rules": [
    {"id": "RULE-01", "family": "numeral", "name": "eleven", "re": "\\beleven\\b", "flags": "gi", "prior": "positive control; already measured at 84x by W1-LIBRARY r1"},
    {"id": "RULE-02", "family": "numeral", "name": "nineteen", "re": "\\bnineteen\\b", "flags": "gi", "prior": "the verdict noticed 'nineteen years' twice as a career length"},
    {"id": "RULE-03", "family": "numeral", "name": "thirteen", "re": "\\bthirteen\\b", "flags": "gi", "prior": "odd mid-teens numbers read as deliberate-specific"},
    {"id": "RULE-04", "family": "numeral", "name": "seventeen", "re": "\\bseventeen\\b", "flags": "gi", "prior": "same family as 11/13/19"},
    {"id": "RULE-05", "family": "numeral", "name": "odd-specific teens (11,13,17,19)", "re": "\\b(eleven|thirteen|seventeen|nineteen)\\b", "flags": "gi", "prior": "the family, not the token; a fix that only moves the spike sideways must not pass this"},
    {"id": "RULE-06", "family": "numeral", "name": "spelled counts four..twenty", "re": "\\b(four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)\\b", "flags": "gi", "prior": "naming a number where a writer would say 'a few'"},
    {"id": "RULE-07", "family": "numeral", "name": "vague quantifier", "re": "\\b(a few|several|a handful|a dozen|some of|many of|most of)\\b", "flags": "gi", "prior": "the INVERSE control: real writers reach for these; expect ours to be LOW"},
    {"id": "RULE-08", "family": "numeral", "name": "round hundreds", "re": "\\b(one|two|three|four|five|six|seven|eight|nine)\\s+hundred\\b", "flags": "gi", "prior": "'four hundred years' as a stock span"},
    {"id": "RULE-09", "family": "numeral", "name": "N of us / N of them", "re": "\\b(two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\\s+of\\s+(us|them|it|the)\\b", "flags": "gi", "prior": "partitive count construction"},
    {"id": "RULE-10", "family": "antithesis", "name": "not X but Y", "re": "\\bnot\\b[^.;:!?]{1,60}?\\bbut\\b", "flags": "gi", "prior": "the signature LLM balance figure"},
    {"id": "RULE-11", "family": "antithesis", "name": "it is not X. it is Y.", "re": "\\b(it|that|this)\\s+is\\s+not\\b[^.!?]{0,60}[.!?]\\s+(It|That|This)\\s+is\\b", "flags": "g", "prior": "two-beat correction across a full stop"},
    {"id": "RULE-12", "family": "antithesis", "name": "less X than Y", "re": "\\bless\\b[^.;:!?]{1,40}?\\bthan\\b", "flags": "gi", "prior": "comparative balance figure"},
    {"id": "RULE-13", "family": "antithesis", "name": "neither ... nor", "re": "\\bneither\\b[^.;:!?]{1,60}?\\bnor\\b", "flags": "gi", "prior": "formal paired negation"},
    {"id": "RULE-14", "family": "antithesis", "name": "X does not Y; Y does", "re": "\\bdoes not\\b[^.;:!?]{1,50}?\\b(and|but)\\b[^.;:!?]{1,30}?\\bdoes\\b", "flags": "gi", "prior": "grain does not flatter and spirit does"},
    {"id": "RULE-15", "family": "gloss", "name": "which is to say", "re": "\\bwhich is to say\\b", "flags": "gi", "prior": "the classic essayistic gloss"},
    {"id": "RULE-16", "family": "gloss", "name": "which is why", "re": "\\bwhich is why\\b", "flags": "gi", "prior": "explanatory relative, very common in generated prose"},
    {"id": "RULE-17", "family": "gloss", "name": "which is / which was mid-sentence", "re": ",\\s+which\\s+(is|was|are|were)\\b", "flags": "gi", "prior": "non-restrictive gloss clause"},
    {"id": "RULE-18", "family": "gloss", "name": "that is what / that is why / that is all", "re": "\\bthat is (what|why|all|not|the)\\b", "flags": "gi", "prior": "summary cadence"},
    {"id": "RULE-19", "family": "gloss", "name": "is-what cleft", "re": "\\bis what\\b", "flags": "gi", "prior": "pseudo-cleft, 'X is what matters'"},
    {"id": "RULE-20", "family": "gloss", "name": "the question that matters / what matters", "re": "\\b(what|that) matters\\b", "flags": "gi", "prior": "editorialising"},
    {"id": "RULE-21", "family": "punctuation", "name": "em dash", "re": "\\u2014", "flags": "g", "prior": "the most reported machine tell"},
    {"id": "RULE-22", "family": "punctuation", "name": "paired em-dash aside in one sentence", "re": "\\u2014[^.!?\\u2014]{1,80}\\u2014", "flags": "g", "prior": "parenthetical aside habit"},
    {"id": "RULE-23", "family": "punctuation", "name": "semicolon", "re": ";", "flags": "g", "prior": "generated prose over-uses the semicolon"},
    {"id": "RULE-24", "family": "punctuation", "name": "mid-sentence colon", "re": "\\w:\\s+[a-z]", "flags": "g", "prior": "colon-then-explanation"},
    {"id": "RULE-25", "family": "punctuation", "name": "parentheses", "re": "\\(", "flags": "g", "prior": "control: expect low both sides"},
    {"id": "RULE-26", "family": "rhythm", "name": "tricolon (X, Y and Z)", "re": "\\b\\w+,\\s+\\w+,?\\s+and\\s+\\w+\\b", "flags": "gi", "prior": "three-item list, the rule-of-three habit"},
    {"id": "RULE-27", "family": "rhythm", "name": "tricolon of clauses (comma, comma, and)", "re": "[^.!?]{6,60},[^.!?]{6,60},[^.!?]{0,20}\\band\\b", "flags": "gi", "prior": "longer rule-of-three"},
    {"id": "RULE-28", "family": "rhythm", "name": "sentence-final wry qualifier", "re": ",\\s+(which|and that|and it|and this)\\s+[^,.!?]{2,60}[.!?]", "flags": "gi", "prior": "ends the sentence on a dry aside"},
    {"id": "RULE-29", "family": "rhythm", "name": "sentence-initial And/But", "re": "(^|[.!?]\\s+)(And|But)\\s", "flags": "g", "prior": "conversational opener"},
    {"id": "RULE-30", "family": "rhythm", "name": "sentence-initial participial clause", "re": "(^|[.!?]\\s+)\\w+ing\\b[^,.!?]{2,50},", "flags": "g", "prior": "'Having counted the shafts, ...'"},
    {"id": "RULE-31", "family": "hedge", "name": "of course", "re": "\\bof course\\b", "flags": "gi", "prior": "knowing aside"},
    {"id": "RULE-32", "family": "hedge", "name": "presumably / evidently / arguably", "re": "\\b(presumably|evidently|arguably|ostensibly)\\b", "flags": "gi", "prior": "essayistic hedging"},
    {"id": "RULE-33", "family": "hedge", "name": "so far as / as far as I can tell", "re": "\\b(so|as) far as (I|anyone|anybody|we)\\b", "flags": "gi", "prior": "narrator's epistemic disclaimer"},
    {"id": "RULE-34", "family": "hedge", "name": "I record / I set down / I note", "re": "\\bI (record|set down|note|write) (this|that|it)\\b", "flags": "gi", "prior": "scribal self-reference"},
    {"id": "RULE-35", "family": "hedge", "name": "without embarrassment / without apology", "re": "\\bwithout (embarrassment|apology|shame|comment)\\b", "flags": "gi", "prior": "seen in the verdict's quoted overlap"},
    {"id": "RULE-36", "family": "register", "name": "contraction avoidance: do/does/did not", "re": "\\b(do|does|did|is|are|was|were|would|could|will|have|has) not\\b", "flags": "gi", "prior": "generated prose avoids contractions"},
    {"id": "RULE-37", "family": "register", "name": "contractions present", "re": "\\b\\w+'(t|s|re|ve|ll|d|m)\\b", "flags": "gi", "prior": "INVERSE control: expect Morrowind HIGH, ours LOW"},
    {"id": "RULE-38", "family": "register", "name": "cannot", "re": "\\bcannot\\b", "flags": "gi", "prior": "formal negation"},
    {"id": "RULE-39", "family": "register", "name": "nobody / anybody / somebody", "re": "\\b(nobody|anybody|somebody)\\b", "flags": "gi", "prior": "indefinite-person habit"},
    {"id": "RULE-40", "family": "register", "name": "the kind of / the sort of", "re": "\\bthe (kind|sort) of\\b", "flags": "gi", "prior": "categorising qualifier"},
    {"id": "RULE-41", "family": "register", "name": "in the way that", "re": "\\bin (the|a) way that\\b", "flags": "gi", "prior": "manner-clause habit"},
    {"id": "RULE-42", "family": "register", "name": "there is no / there was no", "re": "\\bthere (is|was) no\\b", "flags": "gi", "prior": "existential negation"},
    {"id": "RULE-43", "family": "register", "name": "exactly / precisely", "re": "\\b(exactly|precisely)\\b", "flags": "gi", "prior": "emphatic precision"},
    {"id": "RULE-44", "family": "register", "name": "it is not a joke / not a figure of speech", "re": "\\b(is|was) not (a|an) [a-z]+\\b", "flags": "gi", "prior": "pre-emptive disclaimer"},
    {"id": "RULE-45", "family": "shape", "name": "mean sentence length", "kind": "metric", "prior": "generated prose runs long and even"},
    {"id": "RULE-46", "family": "shape", "name": "sentence-length standard deviation", "kind": "metric", "prior": "generated prose varies less; human writing has short punches"}
  ]
}
