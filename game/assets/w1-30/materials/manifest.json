  "schema": "elder-souls/production-asset-manifest@2",
  "generated_by": "node tools/assets/check-material-coverage.mjs --write",
  "build_spec": "tools/assets/material-library.json",
  "licence": {
    "licence": "CC0-1.0",
    "source": "https://polyhaven.com/license",
    "note": "Poly Haven releases all library assets under CC0 and permits commercial use and redistribution.",
    "api": "https://api.polyhaven.com/files/<slug>",
    "maps": [
      "Diffuse",
      "nor_gl",
      "Rough"
    ],
    "resolution": "1k",
    "format": "jpg"
  },
  "conversion": {
    "albedo": "ffmpeg -i <diffuse> -vf scale=1024:1024,eq=saturation=0.55 -q:v 4 <slug>_albedo_1k.jpg",
    "normal": "ffmpeg -i <nor_gl> -vf scale=1024:1024 -q:v 3 <slug>_normal_1k.jpg",
    "rough": "ffmpeg -i <rough> -vf format=gray,scale=512:512 -q:v 5 <slug>_rough_512.jpg",
    "why_desaturated": "The source sets carry their own strong colour identity (rusty orange, red leather). Black Marsh's regional palette must lead, so albedo is desaturated to 0.55 at conversion: pigment variation survives, the source's colour opinion does not. The former pipeline went further and neutralised colour entirely, which is one reason the province reads as grey.",
    "why_rough_at_512": "Roughness is a low-frequency signal; halving it costs nothing visible and takes the whole library under the 320 MB high-tier texture budget without a KTX2 toolchain.",
    "adjust": "Per-slug ffmpeg eq adjustments, applied after the shared desaturation, recorded in families[].adjust. They exist because two of the source sets are lit far brighter than a Black Marsh frame and came out of the close-up rig as white paper."
  },
  "ktx2": {
    "state": "deferred",
    "reason": "Neither basisu nor toktx is installed on this host and neither is vendorable as a build dependency here. The budget is met without them by keeping roughness at 512 (see conversion.why_rough_at_512); the measured high-tier figure is recorded below. Reversal is one command per file once a KTX2 encoder exists.",
    "measured_high_mb": 281.3,
    "measured_medium_mb": 70.3,
    "budget_high_mb": 320,
    "budget_medium_mb": 120
  },
