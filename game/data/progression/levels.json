    "agility",
    "speed",
    "vigour",
    "willpower",
    "intellect",
    "hist-bond",
    "personality",
    "luck"
  ],
  "attributes_note": "RI-PRG02 §1. Ten, and all ten are on the level-up screen at once (RI-UIX03 L5).",
