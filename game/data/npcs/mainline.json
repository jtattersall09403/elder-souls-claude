{
  "schema": "elder-souls/npcs@1",
  "group": "mainline",
  "owner": "W1-19 — the main quest, end to end",
  "source": "The people the mainline names. Every `giver.npc_id`, every `deceit.revealed_by[].source` that is a person, and every id that appears as a key of `consequences.npc_disposition` in game/data/quests/mainline-act1..5.json and mainline-backpath.json. Written because the quests referred to twenty-six people who did not exist as records anywhere in the build, which made `giver.disposition_min` unreachable and made the mainline unofferable from a cold start.",
  "consumed_by": "game/src/engine.js seedDispositions() — `disposition` here is copied into sim.quest.dispositions at boot and on every reset, which is what QuestEngine.context() reads and what gate.js canOffer() checks against giver.disposition_min. Before W1-19 nothing in the build read this field on any NPC record in any file, so every authored disposition in game/data/npcs/** was inert and every quest with a disposition_min was unofferable without a Charm spell.",
  "declared_incomplete": true,
  "declared_incomplete_note": "Wave 1. These records carry id, name, race, settlement, disposition, topics and one greeting line each. Schedules, services, interiors and reaction groups are W1-04's and W1-17's and are not filled here.",
  "npcs": [
    { "id": "undersexton-aveline-rell", "name": "Aveline Rell", "race": "breton", "class": "undersexton", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 45, "topics": ["the drowned tally", "the empty boxes", "the cold well", "a name for cover", "the ninth recension", "the crypt road", "the intakes", "the chapter's vote", "the works"], "services": [], "lines": { "greeting": "You will be the one off the customs bench. Sit down where I can see the stair." } },
    { "id": "undersexton-bel-mourne", "name": "Bel Mourne", "race": "imperial", "class": "undersexton", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 45, "topics": ["the low chapel", "the ninth clause of the Drowned Tally", "the ash gallery"], "services": [], "lines": { "greeting": "Come down before the tide or not at all, and come down alone." } },
    { "id": "ledgerer-hosk-vei", "name": "Hosk-Vei", "race": "saxhleel", "class": "archivist", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 45, "topics": ["the drowned tally", "reading the count", "the thread is cut", "the three previous severances"], "services": [], "lines": { "greeting": "Thirty years and nobody has read past the sixth volume. Wedge the door behind you." } },
    { "id": "ojal-weeth", "name": "Ojal-Weeth", "race": "saxhleel", "class": "mortuary hand", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 40, "topics": ["the empty boxes", "the count of forty", "what people say happened"], "services": [], "lines": { "greeting": "Not in here. Outside, where the sound is." } },
    { "id": "soulrest-sexton-on-duty", "name": "Sexton Corvo Sedd", "race": "imperial", "class": "sexton", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 35, "topics": ["the low chapel", "the empty boxes"], "services": [], "lines": { "greeting": "The Court is not one thing. Whatever she told you, it is not one thing." } },
    { "id": "sexton-ravel-doun", "name": "Ravel Doun", "race": "breton", "class": "sexton", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 30, "topics": ["the chapter's vote"], "services": [], "lines": { "greeting": "Whatever you have heard about my accounts, I would rather hear it from you than from the floor." } },
    { "id": "sexton-ivrenne-mour", "name": "Ivrenne Mour", "race": "breton", "class": "sexton", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 40, "topics": ["the chapter's vote", "the ninth clause of the Drowned Tally"], "services": [], "lines": { "greeting": "I have read that clause in four copies and believed it in none. Do you?" } },
    { "id": "soulrest-customs-clerk", "name": "Nerien Vass", "race": "imperial", "class": "clerk", "faction": null, "settlement": "soulrest", "disposition": 35, "topics": ["the drowned tally"], "services": [], "lines": { "greeting": "The Court pays outlanders to carry its books. It will not put its own on that road." } },
    { "id": "gideon-court-factor", "name": "Halvo Nirith", "race": "dunmer", "class": "factor", "faction": "the_drowned_court", "settlement": "gideon", "disposition": 40, "topics": ["the drowned tally"], "services": ["barter"], "lines": { "greeting": "She knows what is in her own quarterlies. So what did she send you for?" } },
    { "id": "sedd-ravano", "name": "Sedd Ravano", "race": "imperial", "class": "agent", "faction": "the_wet_ledger", "settlement": "gideon", "disposition": 25, "topics": ["the drowned tally"], "services": [], "lines": { "greeting": "You walk slowly for a courier. I noticed that four days ago." } },
    { "id": "gideon-quay-porter", "name": "Eeja-Sul", "race": "saxhleel", "class": "porter", "faction": "the_dockhands", "settlement": "gideon", "disposition": 35, "topics": ["the drowned tally"], "services": [], "lines": { "greeting": "I said it once and I am not saying it twice." } },
    { "id": "keeper-teeja-lun", "name": "Teeja-Lun", "race": "saxhleel", "class": "rootkeeper", "faction": "the_rootkeepers", "settlement": null, "disposition": 45, "topics": ["the cold well", "what the wells do now"], "services": [], "lines": { "greeting": "Whose count are you carrying?" } },
    { "id": "bone-ladder-carter", "name": "Falus Grey", "race": "nord", "class": "carter", "faction": null, "settlement": null, "disposition": 30, "topics": ["the drowned tally", "the cold well"], "services": [], "lines": { "greeting": "Ladder well has gone cold and the keeper has not left it. That is all I know and all I want to." } },
    { "id": "neeja-xul", "name": "Neeja-Xul", "race": "saxhleel", "class": "sap-cutter", "faction": "the_ixtu_vakh", "settlement": "blackrose", "disposition": 40, "topics": ["the cutting yard", "the skei", "the cutters' terms", "the eleven live roots", "the root channels"], "services": [], "lines": { "greeting": "I cut wells for money and I do not pretend otherwise. What does the Court say we have done?" } },
    { "id": "blackrose-yard-hands", "name": "the Blackrose yard hands", "race": "saxhleel", "class": "cutters", "faction": "the_ixtu_vakh", "settlement": "blackrose", "disposition": 30, "topics": ["the cutting yard"], "services": [], "lines": { "greeting": "Ask for the reed-walk and follow your nose from the end of it." } },
    { "id": "harbourmaster-cuiro-vaneth", "name": "Cuiro Vaneth", "race": "imperial", "class": "harbourmaster", "faction": "the_wet_ledger", "settlement": "archon", "disposition": 40, "topics": ["the gem shipping", "the salt factor"], "services": ["barter"], "lines": { "greeting": "The manifests are public. A hundred and fifty says you would rather not read them in public." } },
    { "id": "archon-crane-crew", "name": "the Archon crane crew", "race": "saxhleel", "class": "labourers", "faction": "the_dockhands", "settlement": "archon", "disposition": 35, "topics": ["the gem shipping", "the salt factor"], "services": [], "lines": { "greeting": "Buy us a drink and do not write anything down." } },
    { "id": "archon-bond-clerk", "name": "Sera Idrano", "race": "dunmer", "class": "clerk", "faction": "the_wet_ledger", "settlement": "archon", "disposition": 30, "topics": ["the gem shipping"], "services": [], "lines": { "greeting": "The bonded store shuts at the third bell and is watched after it." } },
    { "id": "salt-factor-neloth-vaun", "name": "Neloth Vaun", "race": "dunmer", "class": "salt-factor", "faction": "house_dres", "settlement": "archon", "disposition": 45, "topics": ["the salt factor", "the clause"], "services": ["barter"], "lines": { "greeting": "I do not care about your tide. I care what sixty hands under an Imperial writ does to the price of stock." } },
    { "id": "rootkeeper-ashul-tei", "name": "Ashul-Tei", "race": "saxhleel", "class": "rootkeeper", "faction": "the_xul_aneekh", "settlement": "helstrom", "disposition": 45, "topics": ["the root gallery", "the interior's consent", "the eleven wells"], "services": [], "lines": { "greeting": "The roots said you were coming. Come without the Court's mark and do not write in my gallery." } },
    { "id": "helstrom-gallery-keepers", "name": "the keepers of the root gallery", "race": "saxhleel", "class": "rootkeepers", "faction": "the_xul_aneekh", "settlement": "helstrom", "disposition": 30, "topics": ["the interior's consent"], "services": [], "lines": { "greeting": "The coast is a wound and wounds are cut out." } },
    { "id": "rootkeeper-sesh-anaat", "name": "Sesh-Anaat", "race": "saxhleel", "class": "rootkeeper", "faction": "the_rootkeepers", "settlement": "thorn", "disposition": 45, "topics": ["the tree at thorn", "the keepers' leave", "the leave book"], "services": [], "lines": { "greeting": "The tree has asked for you. Trees do not do this." } },
    { "id": "factor-ruvela-sath", "name": "Ruvela Sath", "race": "breton", "class": "factor", "faction": "the_wet_ledger", "settlement": "gideon", "disposition": 45, "topics": ["the ledger's terms", "the compact"], "services": ["barter"], "lines": { "greeting": "The compact does not vote on theology and will not be asked to." } },
    { "id": "prefect-galvus-arn", "name": "Galvus Arn", "race": "imperial", "class": "prefect", "faction": "the_imperial_assize", "settlement": "stormhold", "disposition": 45, "topics": ["the writ of works", "the cohorts stormhold does not have"], "services": [], "lines": { "greeting": "A writ of works normally requires four things. You have none of them. Sit down anyway." } },
    { "id": "dockmaster-weeja-sen", "name": "Weeja-Sen", "race": "saxhleel", "class": "dockmaster", "faction": "the_dockhands", "settlement": "lilmoth", "disposition": 40, "topics": ["the hiring list", "the rotting quarter"], "services": [], "lines": { "greeting": "Sixty hands. Somebody has already told me what the work is. Tell me again and we will see which of you is lying." } },
    { "id": "lilmoth-rootkeepers", "name": "the rootkeepers of the rotting quarter", "race": "saxhleel", "class": "rootkeepers", "faction": "the_rootkeepers", "settlement": "lilmoth", "disposition": 20, "topics": ["the rotting quarter"], "services": [], "lines": { "greeting": "The Empire is not a thing that exists in here." } },
    { "id": "lilmoth-yard-brothers", "name": "the Lilmoth cutters", "race": "saxhleel", "class": "cutters", "faction": "the_ixtu_vakh", "settlement": "lilmoth", "disposition": 20, "topics": ["the fourth yard", "the cutters' terms"], "services": [], "lines": { "greeting": "We are paid a year in advance and we do not describe the work." } },
    { "id": "lilmoth-wharf-cutters", "name": "the wharf-end yard", "race": "saxhleel", "class": "cutters", "faction": "the_ixtu_vakh", "settlement": "lilmoth", "disposition": 20, "topics": ["the fourth yard"], "services": [], "lines": { "greeting": "There is no yard at this end of the wharf." } },
    { "id": "blackwood-company-factor", "name": "Corvus Aldeyn", "race": "imperial", "class": "factor", "faction": null, "settlement": "lilmoth", "disposition": 25, "topics": ["the works", "the fourth yard"], "services": ["barter"], "lines": { "greeting": "A jar of Cyrodiilic wine, with a note. Tell me when you go down and I will tell you what I know." } },
    { "id": "blackwood-company-camp", "name": "the Company's camp", "race": "imperial", "class": "labourers", "faction": null, "settlement": null, "disposition": 20, "topics": ["the works"], "services": [], "lines": { "greeting": "Our writ is out of Leyawiin and it says nothing about the Stone Wastes, which you are welcome to read at a distance." } },
    { "id": "keeper-ei-vashan", "name": "Ei-Vashan", "race": "saxhleel", "class": "intake keeper", "faction": null, "settlement": null, "disposition": 40, "topics": ["the ash gallery", "the sill", "what the wells do now"], "services": [], "lines": { "greeting": "Two hundred years at the fifth intake. I have worked out roughly what you have come to do." } },
    { "id": "gallery-intake-keepers", "name": "the keepers of the intakes", "race": "saxhleel", "class": "intake keepers", "faction": null, "settlement": null, "disposition": 35, "topics": ["the ash gallery", "the opening of the count"], "services": [], "lines": { "greeting": "We have been expecting a tally-reader for a hundred and forty years." } },
    { "id": "ixtu-meer", "name": "Ixtu-Meer", "race": "saxhleel", "class": "steward", "faction": null, "settlement": null, "disposition": 50, "topics": ["the steward of the count", "the sill", "the opening of the count"], "services": [], "lines": { "greeting": "I wrote that letter. Is Ashul-Tei well? Sit down; we have time." } },
    { "id": "npc-sesh-weth", "name": "Sesh-Weth", "race": "saxhleel", "class": "mortuary hand", "faction": "the_drowned_court", "settlement": "soulrest", "disposition": 35, "topics": ["the intakes"], "services": [], "lines": { "greeting": "I have had this chest thing for years. It is not the sound that is doing it." } },
    { "id": "npc-sexton-ivo-sarn", "name": "Ivo Sarn", "race": "imperial", "class": "sexton", "faction": "the_drowned_court", "settlement": null, "disposition": 0, "topics": ["the crypt road"], "services": [], "lines": { "greeting": "" } },
    { "id": "npc-the-thing-in-the-third-bay", "name": "what was left in the third bay", "race": "none", "class": "ward", "faction": null, "settlement": null, "disposition": 0, "topics": [], "services": [], "lines": { "greeting": "" } },
    { "id": "aftermath-province-npcs", "name": "the province, afterwards", "race": "mixed", "class": "commoners", "faction": null, "settlement": null, "disposition": 35, "topics": ["what people say happened", "what the wells do now"], "services": [], "lines": { "greeting": "Nothing happened. The Court made all of it up and you are the proof." } }
  ]
}
