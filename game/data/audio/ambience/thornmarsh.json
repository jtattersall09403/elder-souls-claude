{
  "schema": "elder-souls/ambience-bed@1",
  "id": "thornmarsh",
  "region": "thornmarsh",
  "region_name": "Thornmarsh",
  "danger_tier": 4,
  "brief": "thorn-clatter like dice in a cup; NO birdsong inside the thicket",
  "regions_json_audio": [
    "amb_thorn_clatter",
    "amb_no_birdsong",
    "sfx_ash_fall"
  ],
  "key": {
    "wet_dry": "dry",
    "open_enclosed": "enclosed",
    "living_dead": "dead"
  },
  "bed_lufs_target": -27,
  "crossfade_s": 4,
  "max_voices": 8,
  "denies": [
    {
      "class": "birdsong",
      "why": "RI-AUD03 §B and regions.json both: \"NO birdsong inside the thicket\". Thornmarsh is one of the two most distinctive regions in the province precisely because the layer everyone would add is missing."
    },
    {
      "class": "wind",
      "why": "a thicket this dense has no air movement and no distance — hence a dead-air room tone rather than an outdoor L1."
    }
  ],
  "layers": {
    "L1": {
      "id": "l1_dead_air_room_tone",
      "text": "dead-air room tone — a thicket has no distance",
      "level_db": 0,
      "voices": 1,
      "classes": [
        "pressure"
      ],
      "synth": {
        "kind": "noise",
        "colour": "brown",
        "filter": {
          "type": "bandpass",
          "hz": 255,
          "q": 4.2
        },
        "gain_db": -8,
        "width": 0.05,
        "mod": {
          "target": "gain",
          "lfo_hz": 0.023,
          "depth": 0.12
        }
      }
    },
    "L2": {
      "id": "l2_thorn_clatter_only",
      "text": "NO birdsong inside the thicket → L2 is thorn-clatter only",
      "level_db": -4,
      "voices": 2,
      "sublayers": [
        {
          "when": {
            "tod": "day"
          },
          "classes": [
            "flora"
          ],
          "synth": {
            "kind": "noise",
            "colour": "white",
            "filter": {
              "type": "bandpass",
              "hz": 2900,
              "q": 3.4
            },
            "gain_db": -13,
            "width": 0.5,
            "mod": {
              "target": "gain",
              "lfo_hz": 2.7,
              "depth": 0.6
            }
          },
          "text": "thorn-clatter only — no birdsong inside the thicket, by day the thorn is what moves"
        },
        {
          "when": {
            "tod": "night"
          },
          "text": "the clatter stops after dark and the dead-air room tone closes in — a thicket at night has less in it than a thicket by day, and that is the identity, not a quieter version of it.",
          "classes": [
            "pressure"
          ],
          "synth": {
            "kind": "noise",
            "colour": "brown",
            "filter": {
              "type": "lowpass",
              "hz": 365,
