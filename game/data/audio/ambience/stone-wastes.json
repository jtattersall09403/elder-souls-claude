  "denies": [
    {
      "class": "insect_layer",
      "why": "nothing lives here to make one. Stone Wastes is tier 5 and its silence is the S9 lethality warning (§Seam 3)."
    },
    {
      "class": "birdsong",
      "why": "no birds in the Stone Wastes, day or night."
    },
    {
      "class": "standing_water",
      "why": "RI-WLD10 §7: one of the two regions with no standing water at all."
    }
  ],
