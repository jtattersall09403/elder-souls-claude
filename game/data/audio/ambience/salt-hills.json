  "emitters": [
    {
      "id": "legion_horn",
      "text": "the legion horn on the hour: a diegetic clock at a fixed place, so hearing it tells you both the time and the bearing to the fort (R7). ROUND 2 — `phase` 0.002 puts the first strike 7.2 s into a capture, i.e. the §C clip is DELIBERATELY taken across the hour. That is a declared bias and it is declared because RI-AUD03 §C leans on it: the grading key gives Salt Hills (dry, open, living) and it gives The Clay Moor the same triple, so those two are separated by Q3 — horn versus kiln — exactly as the four (wet, open, living) regions are. An hourly event has a 0.6 % duty cycle in a 20 s window; a capture that does not phase it cannot separate the pair, and a capture that does must say so.",
      "pos_m": [
        1982,
        706
      ],
      "audible_m": 900,
      "ref_m": 60,
      "level_db": 2,
      "classes": [
        "navigation"
      ],
      "period_s": 3600,
      "on_the_hour": true,
      "synth": {
        "kind": "grain",
        "source": "osc",
        "waveform": "sawtooth",
        "freq_hz": 146.83,
        "partials_hz": [
          146.83,
