{
  "schema": "elder-souls/ambience-bed@1",
  "id": "valus-ridge",
  "region": "valus-ridge",
  "region_name": "Valus Ridge",
  "danger_tier": 4,
  "brief": "wind through rock flutes (a real audible chord); rockfall; hackwing screams",
  "regions_json_audio": [
    "amb_rock_flute_chord",
    "sfx_rockfall",
    "sfx_hackwing_scream"
  ],
