  "denies": [
    {
      "class": "insect_layer",
      "why": "altitude. Nothing swarms on the ridge."
    },
    {
      "class": "standing_water",
      "why": "RI-WLD10 §7: no standing water."
    }
  ],
  "layers": {
    "L1": {
      "id": "l1_rock_flute_chord",
      "text": "wind through rock flutes — a REAL AUDIBLE CHORD. The only tonal L1 with a defined pitch set: D3 F3 A3 C4, a D-minor seventh, blown rather than played. Raised 4 dB over its own L2 in W1-22 round 1: measured against the Salt Hills the two were the only pair in the province below the separation floor (0.086), because the chord was buried under the altitude wind and both regions read as broadband wind. A tonal L1 nobody can hear is not a tonal L1.",
      "level_db": 0,
      "voices": 1,
      "classes": [
        "wind"
      ],
      "synth": {
        "kind": "drone",
        "waveform": "sine",
        "partials_hz": [
          146.83,
          174.61,
          220,
          261.63
        ],
        "partial_gains_db": [
          -7,
          -11,
          -12,
          -17
        ],
        "detune_cents": 9,
        "gain_db": -2,
        "filter": {
          "type": "bandpass",
          "hz": 240,
          "q": 1.2
        },
        "mod": {
          "target": "gain",
          "lfo_hz": 0.11,
          "depth": 0.42
        }
      }
    },
    "L2": {
      "id": "l2_altitude_wind",
      "text": "high thin altitude wind",
      "level_db": -10,
      "voices": 2,
      "sublayers": [
        {
          "when": {
            "tod": "day"
          },
          "classes": [
            "wind"
          ],
          "synth": {
            "kind": "noise",
            "colour": "white",
            "filter": {
              "type": "highpass",
              "hz": 2400,
              "q": 0.6
            },
            "gain_db": -14,
            "width": 0.85,
            "mod": {
              "target": "filter_hz",
              "lfo_hz": 0.13,
              "depth": 0.45
            }
          },
          "text": "high thin altitude wind — the daytime upslope wind, thin and above the chord"
        },
        {
          "when": {
            "tod": "night"
          },
          "text": "the mountain wind reverses after dark and comes DOWN the slope: heavier, an octave and a half lower, and it blows a different mouth on the rock flutes. The chord (L1) is unchanged; what is blowing it is not.",
          "classes": [
            "wind"
          ],
          "synth": {
            "kind": "noise",
            "colour": "pink",
            "filter": {
              "type": "bandpass",
              "hz": 690,
              "q": 0.85
            },
            "gain_db": -12,
            "width": 0.9,
            "mod": {
              "target": "filter_hz",
              "lfo_hz": 0.047,
              "depth": 0.6
            }
          }
        }
      ]
    },
