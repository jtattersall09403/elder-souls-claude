        "filter": {
          "type": "lowpass",
          "hz": 2600,
          "q": 0.9
        }
      },
      "gradient": {
        "source": "distance_to_anchor",
        "anchor_m": [
          1237,
          3732
        ],
        "span_m": 700,
        "pitch_cents_near": -420,
        "pitch_cents_far": 260,
        "note": "RI-AUD03 §B. The queen is the anchor; the chord flattens as you approach her. A player who has learned it can walk to her with the screen off, which is the S8 no-markers ruling paid for in sound."
      }
    },
    "L2": {
      "id": "l2_wing_wash",
      "text": "wing-wash",
      "level_db": -4,
      "voices": 2,
      "sublayers": [
