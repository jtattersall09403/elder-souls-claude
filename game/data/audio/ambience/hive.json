{
  "schema": "elder-souls/ambience-bed@1",
  "id": "hive",
  "region": "hive",
  "region_name": "The Hive",
  "danger_tier": 2,
  "brief": "a single sustained insect chord that shifts pitch with distance to the queen",
  "regions_json_audio": [
    "amb_hive_chord"
