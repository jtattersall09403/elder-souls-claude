    {
      "class": "wind",
      "why": "inside a hive there is no weather. Wing-wash is the only air movement."
    }
  ],
  "layers": {
    "L1": {
      "id": "l1_hive_chord_gradient",
      "text": "a single sustained insect chord that SHIFTS PITCH WITH DISTANCE TO THE QUEEN — the only L1 in the game that is a gradient, not a loop",
      "level_db": 0,
      "voices": 1,
      "classes": [
        "insect_layer"
      ],
