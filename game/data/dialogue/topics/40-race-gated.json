            ]
          }
        }
      ]
    },
    {
      "id": "the-hist-that-stopped",
      "infos": [
        {
          "a": "rootkeeper",
          "x": "One did. In the deep marsh. Nobody says why and the village around it did not move away, which is the frightening part.",
          "forbids": {
            "race": [
              "dunmer",
              "imperial",
              "nord",
              "breton",
              "redguard",
              "khajiit",
              "orsimer",
              "bosmer"
            ]
          }
        }
      ]
    },
    {
      "id": "our-arrangement-with-the-legion",
      "infos": [
